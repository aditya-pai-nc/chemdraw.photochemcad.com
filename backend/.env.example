# Backend configuration. Copy to `backend/.env` and edit:
#
#     cp .env.example .env
#
# `backend/.env` is gitignored. Real environment variables always win over this
# file, so a shell export or a CI secret still overrides anything set here.
# Every value below is optional — with none of them set the pipeline behaves
# exactly as it did before the InChIKey and AI columns were added.


# ── Curation of unmatched compounds ──────────────────────────────────────────
# Only compounds that did NOT match exactly are sent to a model, and only their
# relevant fields. Without a key the pass is skipped: the second worksheet still
# lists every unmatched compound and says why, just without a curated answer.
#
# Get one at https://console.anthropic.com/settings/keys — it starts "sk-ant-".
ANTHROPIC_API_KEY=

# The curator only weighs evidence already in front of it — no research, no
# images — so it is deliberately a small model.
# CHEMDRAW_CURATE_MODEL=claude-haiku-4-5-20251001

# "auto" (default) turns curation on whenever a key is present.
# Set 0 to force it off even with a key set; 1 to force it on.
# CHEMDRAW_AI_ENABLED=auto

# Unmatched compounds curated in parallel. ChemDraw must run one at a time, but
# this pass is network-bound and has no such constraint.
# CHEMDRAW_CURATE_CONCURRENCY=4

# Only set this for a model that supports it. Haiku 4.5 does not, and the
# request degrades automatically, so leaving it unset is correct by default.
# CHEMDRAW_CURATE_EFFORT=medium


# ── ChemDraw extraction ──────────────────────────────────────────────────────
# Five representations are pulled per molecule: SMILES, SLN, InChI, InChIKey and
# MOL text. COM (Objects.Data) is tried first; anything it will not give up
# falls back to driving Edit > Copy As by keystroke, which needs the ChemDraw
# window raised. Set 0 to disable the fallback and accept the gaps instead.
# CHEMDRAW_KEYS_FALLBACK=1

# Menu mnemonics, in case they differ in your ChemDraw build. A wrong letter
# silently picks the neighbouring menu entry, so these are configurable.
# CHEMDRAW_COPYAS_KEYS=smiles=s,sln=l,inchi=n,inchikey=k,molfile=m
# CHEMDRAW_EDIT_MENU_KEY=e
# CHEMDRAW_COPY_AS_KEY=o

# How long to wait for the clipboard after the final keystroke, and the pause
# between keystrokes while the menu animates.
# CHEMDRAW_KEYS_TIMEOUT=4.0
# CHEMDRAW_KEYS_DELAY=0.12

# The keystroke route needs a real interactive desktop. It detects for itself
# whether one is reachable (a locked workstation, a disconnected RDP session, or
# a service in session 0 all fail) and falls straight through to COM instead of
# waiting out a clipboard timeout per format. This is how often that is
# re-checked, so reconnecting an RDP session restores it without a restart.
# CHEMDRAW_KEYS_RECHECK=30


# ── PubChem ──────────────────────────────────────────────────────────────────
# One search term can resolve to many records. Fields missing from the first are
# filled from the next candidate that has them.
# CHEMDRAW_PUBCHEM_MAX_CANDIDATES=25
# Candidates walked for CAS / synonyms / Wikipedia, which cost a request each.
# CHEMDRAW_PUBCHEM_MAX_REFERENCE=5

# ── CAS Common Chemistry verification ───────────────────────────────────────
# Request API access: https://www.cas.org/services/commonchemistry-api
# The key stays on the backend and is sent in the X-API-KEY header.
# Without a key, rows say "Not configured" and the rest of the pipeline runs.
CAS_API_KEY=
# CHEMDRAW_CAS_ENABLED=1
# Maximum candidate records inspected per compound (1–20).
# CHEMDRAW_CAS_MAX_CANDIDATES=5

# ── Authentication ───────────────────────────────────────────────────────────
# Unset (the default) means no authentication, which is correct only when
# FastAPI is bound to 127.0.0.1 and the UI runs on the same host.
#
# SET THIS whenever the backend is reachable from anywhere else — a Vercel
# frontend proxying to a Windows box on AWS, for example. Without it every
# endpoint is open: anyone can upload a .cdx and drive ChemDraw on the machine,
# download other jobs' output, and spend the Anthropic key via curation.
#
# The same value must be set as CHEMDRAW_API_TOKEN on the frontend, which
# injects it server-side. The browser never sees it. `/api/health` reports
# whether it is on, so a deployment cannot be open without saying so.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CHEMDRAW_API_TOKEN=


# ── Storage ──────────────────────────────────────────────────────────────────
# CHEMDRAW_DATA_DIR=data/jobs
# CHEMDRAW_INTERP_DIR=data/interpolation
# Bulk CAS extractor uploads/results (no ChemDraw required).
# CHEMDRAW_BULK_CAS_DIR=data/bulk_cas
# Structures written by /api/inchikey/...?save=true
# CHEMDRAW_INCHIKEY_DIR=data/inchikey


# ── Queue and concurrency ────────────────────────────────────────────────────
# CHEMDRAW_MAX_QUEUE=20
# CHEMDRAW_INTERP_CONCURRENCY=2


# ── Networking ───────────────────────────────────────────────────────────────
# Only needed if the API is exposed to a browser directly. In the normal setup
# the browser talks to Next, which proxies server-side, so leave this unset.
# CHEMDRAW_CORS_ORIGINS=
