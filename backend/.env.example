# Backend configuration. Copy to `backend/.env` and edit:
#
#     cp .env.example .env
#
# `backend/.env` is gitignored. Real environment variables always win over this
# file, so a shell export or a CI secret still overrides anything set here.
# Every value below is optional — with none of them set the pipeline behaves
# exactly as it did before the InChIKey and AI columns were added.


# ── AI identification and consensus ──────────────────────────────────────────
# Without a key the AI pass is skipped: `AI Match?` and the consensus columns
# read "—" and everything else works unchanged. Nothing else here needs it.
#
# Get one at https://console.anthropic.com/settings/keys — it starts "sk-ant-".
ANTHROPIC_API_KEY=

# Which models do the work. The identifier reads the drawing and may have to
# research an unfamiliar compound, so it gets the strong model; the referee only
# weighs evidence already in front of it, so it gets the cheap one.
# CHEMDRAW_AI_MODEL=claude-opus-5
# CHEMDRAW_AI_CONSENSUS_MODEL=claude-sonnet-5

# "auto" (default) turns the AI pass on whenever a key is present.
# Set 0 to force it off even with a key set; 1 to force it on.
# CHEMDRAW_AI_ENABLED=auto

# Compounds identified in parallel. ChemDraw must run one at a time, but this
# pass is network-bound and has no such constraint.
# CHEMDRAW_AI_CONCURRENCY=4

# Let the identifier look compounds up, and how deeply it may think.
# CHEMDRAW_AI_WEB_SEARCH=1
# CHEMDRAW_AI_MAX_SEARCHES=6
# CHEMDRAW_AI_EFFORT=high
# CHEMDRAW_AI_CONSENSUS_EFFORT=medium

# Long edge that ChemDraw's TIFF export is downscaled to before being sent.
# Above ~1568px accuracy stops improving and only the bill grows.
# CHEMDRAW_AI_MAX_IMAGE_PX=1568


# ── Storage ──────────────────────────────────────────────────────────────────
# CHEMDRAW_DATA_DIR=data/jobs
# CHEMDRAW_INTERP_DIR=data/interpolation
# Structures written by /api/inchikey/...?save=true
# CHEMDRAW_INCHIKEY_DIR=data/inchikey


# ── Queue and concurrency ────────────────────────────────────────────────────
# CHEMDRAW_MAX_QUEUE=20
# CHEMDRAW_INTERP_CONCURRENCY=2


# ── Networking ───────────────────────────────────────────────────────────────
# Only needed if the API is exposed to a browser directly. In the normal setup
# the browser talks to Next, which proxies server-side, so leave this unset.
# CHEMDRAW_CORS_ORIGINS=
