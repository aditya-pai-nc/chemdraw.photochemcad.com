# Where the FastAPI service listens. The Next proxy calls this server-side, so
# in production FastAPI should bind to 127.0.0.1 only and never be reachable
# from the internet.
CHEMDRAW_API_URL=http://127.0.0.1:8000

# Shared secret required by the backend when CHEMDRAW_API_TOKEN is set there.
# Must match exactly. Read server-side only — never prefix it with NEXT_PUBLIC_,
# which would ship it to the browser and defeat the point.
CHEMDRAW_API_TOKEN=
